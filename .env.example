# ---------------------------------------------------------------------------
# Environment (development defaults shown). PRODUCTION MUST OVERRIDE.
# The application REFUSES to start without a real JWT_SECRET unless NODE_ENV is
# exactly 'development' or 'test' — the development fallback is usable only
# there. In production it also refuses without MFA_ENCRYPTION_KEY.
# See src/app.module.ts and src/shared/auth/jwt-secret.ts.
# ---------------------------------------------------------------------------

NODE_ENV=development

# PostgreSQL
# Host-side tools (npm run migration:*, npm run bootstrap:dev) reach the
# DEVELOPMENT CONTAINER through the port docker-compose.yml publishes for it:
#   FROM HOST          -> 127.0.0.1:5433  (this file; the gym-postgres container)
#   FROM API CONTAINER -> postgres:5432   (docker-compose.yml overrides both)
# A host PostgreSQL cluster normally owns 5432: pointing host-side commands at
# 5432 silently targets that unrelated cluster instead of the dev database, so
# do not do it. Host database commands should use the wrapper, which loads and
# verifies this file against the running container first:
#   scripts/dev-db-env.sh npm run migration:run
#   scripts/dev-db-env.sh npm run bootstrap:dev
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gym_management
# Schema is managed exclusively through migrations (synchronize is hard-disabled
# in src/app.module.ts). Set to "true" to auto-run pending migrations at startup.
DB_MIGRATIONS_RUN=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TTL=0

# JWT (required wherever NODE_ENV is not exactly 'development' or 'test'; a strong
# >=32 char random secret, e.g. `openssl rand -base64 48`)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Refresh token signing secret. REQUIRED in production and must differ from
# JWT_SECRET. Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=
JWT_EXPIRATION=3600
# Refresh token lifetime (seconds)
JWT_REFRESH_EXPIRATION=604800
# MFA challenge token lifetime (seconds)
MFA_CHALLENGE_EXPIRATION=300

# AES-256 key for encrypting MFA secrets at rest.
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# HTTP
PORT=3000

# ── Sentry error tracking (Part 3) ──────────────────────────────────────────────
# SECRET — Sentry DSN (Data Source Name). Get it from your Sentry project:
#   Settings → Projects → <project> → Client Keys (DSN).
# When unset (or empty), Sentry is DISABLED: the app boots and runs normally,
# logging a clear warning at startup. Never commit a real DSN (it is a secret).
# A throwaway/test Sentry project is fine for local verification.
SENTRY_DSN=

# ── Payment gateway (Stripe, Phase 3) ───────────────────────────────────────
# SECRET — server-side Stripe API key. Read through ConfigService
# (src/finance/services/stripe-payment-gateway.adapter.ts:15 and
# src/finance/services/gateway-webhook.service.ts:21). NOT required at boot:
# when unset, the adapter reports itself unconfigured instead of throwing, and
# src/app.boot.spec.ts asserts the real AppModule still compiles and runs with
# it absent. Required only to actually charge a card.
STRIPE_SECRET_KEY=
# SECRET — Stripe webhook endpoint signing secret, used to verify incoming
# webhook signatures (src/finance/services/gateway-webhook.service.ts:20,26-28).
# Also NOT required at boot; while it is unset, every webhook is rejected with
# 400 "Invalid webhook signature".
STRIPE_WEBHOOK_SECRET=

# ── AI (Phase 2B: provider abstraction + retention analysis) ─────────────────
# Master kill-switch. When false (default) every AI endpoint returns 503 and no
# provider is ever called. Production refuses to boot with AI_ENABLED=true and
# AI_PROVIDER=mock, or with an empty AI_API_KEY for the openai provider.
AI_ENABLED=false
# "openai" (real provider) or "mock" (deterministic, offline, dev/test only).
AI_PROVIDER=openai
# SECRET — provider API key. Never commit a real value; never logged.
AI_API_KEY=
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=4096
# 0 keeps structured JSON output deterministic.
AI_TEMPERATURE=0
# Per-attempt provider timeout (ms).
AI_TIMEOUT_MS=30000
# Bounded retries for TRANSIENT failures only (timeout / 429 / 5xx / network).
AI_MAX_RETRIES=2

# ── AI usage limits (Phase 2B.3: rate limiting, token + cost budgets) ───────
# AI requests allowed per fixed 60-second window for one
# (organization, user, request type) tuple.
# Redis key: ai:ratelimit:{organizationId}:{userId}:{requestType}
AI_RATE_LIMIT_RPM=20
# Provider token budget per UTC day for one organization. Provider-reported
# tokens only; a failed call that consumed nothing adds nothing.
# Redis key: ai:budget:{organizationId}:{YYYY-MM-DD}, re-hydrated from AI_USAGE.
AI_RATE_LIMIT_TPD=200000
# Estimated cost budget per UTC month for one organization, in USD. The cost is
# always computed on the server from src/ai/config/ai-pricing.ts and persisted
# on AI_USAGE.estimated_cost_usd; neither the model nor the provider supplies it.
# Redis key: ai:cost:{organizationId}:{YYYY-MM}. Re-hydrated from AI_USAGE.
AI_COST_LIMIT_MONTHLY_USD=25
# 0 explicitly disables the corresponding limit. Over-limit requests are
# rejected with HTTP 429; if Redis is unavailable the request is rejected with
# HTTP 503 instead of being allowed through unmetered. That holds EVEN WHEN
# EVERY LIMIT IS 0: the check that the counter client is present and ready runs
# unconditionally, before the per-limit branches, so a deployment that has
# disabled every limit still refuses rather than silently running unmetered on a
# Redis it cannot reach (R9, 2026-10-04). The 503 carries a Retry-After header.
# Production note: with AI_ENABLED=true, a positive cost limit additionally
# requires AI_MODEL to have a server-side price, otherwise startup fails.

# ── Rate limiting (DEF-07, 2026-10-03; MFA counters DEF-22/DEF-23) ──────────
# Throttling for the five unauthenticated endpoints (register, login, refresh,
# verify-mfa, payment-gateway webhook) plus the three authenticated MFA routes —
# mfa-enable and mfa-disable (DEF-22) and mfa-verify (DEF-23) are the ONLY
# authenticated routes that carry a counter; every other authenticated route is
# NOT throttled, and GET /v1/health is exempt. Every value below is a tunable
# DEFAULT, not a measured value; a value that is present but malformed fails the
# boot. Storage is Redis on the app's existing client (one atomic Lua script).
# If Redis is unavailable, throttling FAILS OPEN — the request is allowed and a
# line is logged — the opposite of the token blacklist, which fails closed.
#
# Login has TWO windows: per IP, and per (IP, email) pair. There is deliberately
# no email-only counter: it would let anyone lock a victim out (Q2).
THROTTLE_LOGIN_IP_LIMIT=30
THROTTLE_LOGIN_IP_TTL_MS=60000
THROTTLE_LOGIN_PAIR_LIMIT=10
THROTTLE_LOGIN_PAIR_TTL_MS=900000
THROTTLE_REGISTER_IP_LIMIT=10
THROTTLE_REGISTER_IP_TTL_MS=3600000
THROTTLE_REFRESH_IP_LIMIT=60
THROTTLE_REFRESH_IP_TTL_MS=60000
THROTTLE_VERIFY_MFA_IP_LIMIT=20
THROTTLE_VERIFY_MFA_IP_TTL_MS=60000

# The authenticated MFA routes (owner ruling 2026-10-05; the third, mfa-verify,
# is the follow-up DEF-23 carries). Unlike every counter above, these are keyed
# by the AUTHENTICATED USER (`req.user.userId`), never by IP: one account's
# 6-digit guessing budget cannot be spent by many callers, and one NAT cannot
# collapse unrelated users into a shared bucket. There is deliberately no IP
# component and no fallback to one — it would let a caller spend a victim's
# budget from elsewhere. Each route keeps its OWN counter, so exhausting one
# leaves the others usable.
THROTTLE_MFA_ENABLE_USER_LIMIT=20
THROTTLE_MFA_ENABLE_USER_TTL_MS=60000
THROTTLE_MFA_DISABLE_USER_LIMIT=20
THROTTLE_MFA_DISABLE_USER_TTL_MS=60000
THROTTLE_MFA_VERIFY_USER_LIMIT=20
THROTTLE_MFA_VERIFY_USER_TTL_MS=60000

THROTTLE_WEBHOOK_IP_LIMIT=600
THROTTLE_WEBHOOK_IP_TTL_MS=60000

# How long one throttling `EVAL` may take before the storage abandons it and
# allows the request (fails open), in milliseconds. Positive integer; a
# malformed value fails the boot. This is a failure bound, not a latency budget:
# healthy replies on a local Redis were measured at ~0.2 ms idle and up to tens
# of ms under load; production network RTT is not measured. It covers the shape
# the not-ready check cannot: a socket that looks ready but has stopped answering.
THROTTLE_STORAGE_TIMEOUT_MS=500

# Express `trust proxy`, which decides what `req.ip` means for every per-IP
# throttle. UNSET MEANS "TRUST NOTHING" — correct when the API is exposed
# directly (the shipped docker-compose shape), and what stops an
# X-Forwarded-For header from resetting a counter. BEHIND ANY REVERSE PROXY THIS
# MUST BE SET, or every client shares the proxy's IP and the per-IP limits
# collapse into one global limit. Accepts a hop count (`1`) or a comma-separated
# list of IPs / CIDR subnets / Express keywords (`loopback,10.0.0.0/8`). A
# malformed value fails the boot.
# TRUST_PROXY=1

# ── Request-path cache calls (DEF-15, 2026-10-04) ────────────────────────────
# How long any request-path cache/Redis call OTHER than the throttler's counters
# may take before it is abandoned, in milliseconds. It covers the token
# blacklist read (every authenticated route), the blacklist write and the MFA
# challenge claim (the auth routes), and the AI usage counters. Integer in
# [1, 10000]; a value outside that range, a fraction, or a non-numeric value
# fails the boot. The 10000 ceiling is deliberate: this is a failure bound, and
# a deadline long enough to outlast an outage bounds nothing.
#
# FAILURE MODE — this is the opposite of the throttler, deliberately. When the
# deadline is hit, each control keeps the answer it already had and only gives
# it sooner: the blacklist REFUSES the token, the MFA challenge claim refuses
# the challenge (so a replay check is never skipped), and the AI usage-limit
# check refuses the request. Nothing here turns into "accept the token".
#
# O1 (owner ruling, 2026-10-04): an infrastructure failure — the deadline, a
# missing client, a client that is known-offline, or a driver error — answers
# HTTP 503 with a Retry-After header, NOT 401. The refusal is unchanged and
# still fails closed; only the status differs, so that an unreachable Redis is
# not reported to the web client as an invalid session (a 401 there makes the
# client run a refresh that also fails, clear the tokens and sign the user out).
# A token that really is blacklisted, an MFA challenge that really was already
# used, and a refresh token that really is revoked all still answer 401. The
# blacklist WRITE answers 503 too — before, a timed-out revocation write
# propagated as an unplanned 500.
# See DEF-15 in docs/task-backlog.md.
#
# 500 ms is a tunable default, not a measurement of this variable: it is the
# same value as THROTTLE_STORAGE_TIMEOUT_MS, taken from the one local-host
# measurement this repo has (DEF-07 Q12: 4.49M evals, none over 250 ms, worst
# 200 ms under 4 CPU hogs). Production network RTT is not measured. This is a
# failure bound, not a latency budget, and it is a SEPARATE variable from the
# throttler's on purpose — that one carries its own owner ruling (Q12).
CACHE_CALL_TIMEOUT_MS=500

# ── Object storage: member documents (S3) ───────────────────────────────────
# Read DIRECTLY from process.env by src/shared/storage/s3.service.ts (not through
# ConfigService), so the defaults below are the service's own fallbacks when a
# variable is unset.
# Local upload root, used ONLY outside production (NODE_ENV !== 'production'),
# where uploads are written to disk instead of S3. This directory is gitignored.
S3_LOCAL_ROOT=./uploads
# Bucket for member document objects in production. Not a credential, but it
# names your infrastructure — override it per environment.
S3_DOCUMENTS_BUCKET=gym-documents
# AWS region for the production S3 client.
AWS_REGION=us-east-1

# ── Background workers (Phase 1) ────────────────────────────────────────────
# Every worker is OFF unless enabled here. A worker that starts scanning every
# tenant as soon as the API boots is an operational surprise, and one process
# should own the scheduling decision rather than every replica.
#   OUTBOX            drains the transactional outbox (outbox.poller.ts)
#   MEMBERSHIP_EXPIRY transitions memberships past their end date (emits
#                     MembershipExpired.v1)
#   PAYMENT_RETRY     retries `pending` payments (idle until a payment gateway
#                     is configured; see src/finance/services/payment-gateway.port.ts)
#   DUNNING           dunning event scan; dispatch is downstream via Outbox (P3-08)
#   CRM_FOLLOW_UPS    generates follow-ups from active SLA policies (P3-07)
#   CRM_SLA_MONITOR   records SLA breaches and escalates them (P3-07)
# WORKERS_ENABLED is the master switch; WORKERS_<NAME>_ENABLED overrides it for
# a single worker. Ticks never overlap themselves, and a failing tick is logged
# without stopping the schedule.
WORKERS_ENABLED=false
# WORKERS_OUTBOX_ENABLED=false
# WORKERS_MEMBERSHIP_EXPIRY_ENABLED=false
# WORKERS_PAYMENT_RETRY_ENABLED=false
# WORKERS_DUNNING_ENABLED=false
# WORKERS_CRM_FOLLOW_UPS_ENABLED=false
# WORKERS_CRM_SLA_MONITOR_ENABLED=false
# Tick intervals in milliseconds (values below 1000 are ignored; the default is
# used instead). Defaults: outbox 10000, membership expiry 3600000, retry 900000.
# WORKERS_OUTBOX_INTERVAL_MS=10000
# WORKERS_MEMBERSHIP_EXPIRY_INTERVAL_MS=3600000
# WORKERS_PAYMENT_RETRY_INTERVAL_MS=900000
# WORKERS_DUNNING_INTERVAL_MS=86400000
# WORKERS_CRM_FOLLOW_UPS_INTERVAL_MS=1800000
# WORKERS_CRM_SLA_MONITOR_INTERVAL_MS=900000

# ── Build provenance (build-time only) ──────────────────────────────────────
# `npm run build` always writes dist/build-info.json with a deterministic
# fingerprint of the build inputs; GET /v1/health reports it so a running image
# can be compared against a workspace.
# Docker image builds REQUIRE GIT_REVISION: the Dockerfile sets
# REQUIRE_GIT_REVISION=true and fails the build when it is missing or is not a
# 7-40 character hex Git object name, because an image that cannot name its
# source revision must not be deployable:
#   GIT_REVISION=$(git rev-parse HEAD) docker compose build api
# Local `npm run build` runs without REQUIRE_GIT_REVISION and keeps the
# documented development fallback (git rev-parse --short=12 HEAD, then
# "unknown"). APP_VERSION overrides the reported version label. Neither value
# ever affects the source fingerprint.
GIT_REVISION=
APP_VERSION=

