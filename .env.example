# ---------------------------------------------------------------------------
# Environment (development defaults shown). PRODUCTION MUST OVERRIDE.
# In production the application REFUSES to start if JWT_SECRET or
# MFA_ENCRYPTION_KEY are missing/weak (see src/app.module.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gym_management
# NEVER enable schema synchronization against a shared/production database.
DB_SYNCHRONIZE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TTL=0

# JWT (production requires a strong >=32 char random secret; e.g. `openssl rand -base64 48`)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRATION=3600
# Refresh token lifetime (seconds)
JWT_REFRESH_EXPIRATION=604800
# MFA challenge token lifetime (seconds)
MFA_CHALLENGE_EXPIRATION=300

# AES-256 key for encrypting MFA secrets at rest.
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# HTTP
PORT=3000
