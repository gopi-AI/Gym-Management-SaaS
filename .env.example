# ---------------------------------------------------------------------------
# Environment (development defaults shown). PRODUCTION MUST OVERRIDE.
# In production the application REFUSES to start if JWT_SECRET or
# MFA_ENCRYPTION_KEY are missing/weak (see src/app.module.ts).
# ---------------------------------------------------------------------------

NODE_ENV=development

# PostgreSQL
# Host-side tools (npm run migration:*, npm run bootstrap:dev) reach the
# DEVELOPMENT CONTAINER through the port docker-compose.yml publishes for it:
#   FROM HOST          -> 127.0.0.1:5433  (this file; the gym-postgres container)
#   FROM API CONTAINER -> postgres:5432   (docker-compose.yml overrides both)
# A host PostgreSQL cluster normally owns 5432: pointing host-side commands at
# 5432 silently targets that unrelated cluster instead of the dev database, so
# do not do it. Host database commands should use the wrapper, which loads and
# verifies this file against the running container first:
#   scripts/dev-db-env.sh npm run migration:run
#   scripts/dev-db-env.sh npm run bootstrap:dev
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=gym_management
# Schema is managed exclusively through migrations (synchronize is hard-disabled
# in src/app.module.ts). Set to "true" to auto-run pending migrations at startup.
DB_MIGRATIONS_RUN=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TTL=0

# JWT (production requires a strong >=32 char random secret; e.g. `openssl rand -base64 48`)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Refresh token signing secret. REQUIRED in production and must differ from
# JWT_SECRET. Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=
JWT_EXPIRATION=3600
# Refresh token lifetime (seconds)
JWT_REFRESH_EXPIRATION=604800
# MFA challenge token lifetime (seconds)
MFA_CHALLENGE_EXPIRATION=300

# AES-256 key for encrypting MFA secrets at rest.
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# HTTP
PORT=3000

# ── Sentry error tracking (Part 3) ──────────────────────────────────────────────
# SECRET — Sentry DSN (Data Source Name). Get it from your Sentry project:
#   Settings → Projects → <project> → Client Keys (DSN).
# When unset (or empty), Sentry is DISABLED: the app boots and runs normally,
# logging a clear warning at startup. Never commit a real DSN (it is a secret).
# A throwaway/test Sentry project is fine for local verification.
SENTRY_DSN=

# ── AI (Phase 2B: provider abstraction + retention analysis) ─────────────────
# Master kill-switch. When false (default) every AI endpoint returns 503 and no
# provider is ever called. Production refuses to boot with AI_ENABLED=true and
# AI_PROVIDER=mock, or with an empty AI_API_KEY for the openai provider.
AI_ENABLED=false
# "openai" (real provider) or "mock" (deterministic, offline, dev/test only).
AI_PROVIDER=openai
# SECRET — provider API key. Never commit a real value; never logged.
AI_API_KEY=
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_TOKENS=4096
# 0 keeps structured JSON output deterministic.
AI_TEMPERATURE=0
# Per-attempt provider timeout (ms).
AI_TIMEOUT_MS=30000
# Bounded retries for TRANSIENT failures only (timeout / 429 / 5xx / network).
AI_MAX_RETRIES=2

# ── AI usage limits (Phase 2B.3: rate limiting, token + cost budgets) ───────
# AI requests allowed per fixed 60-second window for one
# (organization, user, request type) tuple.
# Redis key: ai:ratelimit:{organizationId}:{userId}:{requestType}
AI_RATE_LIMIT_RPM=20
# Provider token budget per UTC day for one organization. Provider-reported
# tokens only; a failed call that consumed nothing adds nothing.
# Redis key: ai:budget:{organizationId}:{YYYY-MM-DD}, re-hydrated from AI_USAGE.
AI_RATE_LIMIT_TPD=200000
# Estimated cost budget per UTC month for one organization, in USD. The cost is
# always computed on the server from src/ai/config/ai-pricing.ts and persisted
# on AI_USAGE.estimated_cost_usd; neither the model nor the provider supplies it.
# Redis key: ai:cost:{organizationId}:{YYYY-MM}. Re-hydrated from AI_USAGE.
AI_COST_LIMIT_MONTHLY_USD=25
# 0 explicitly disables the corresponding limit. Over-limit requests are
# rejected with HTTP 429; if Redis is unavailable the request is rejected with
# HTTP 503 instead of being allowed through unmetered.
# Production note: with AI_ENABLED=true, a positive cost limit additionally
# requires AI_MODEL to have a server-side price, otherwise startup fails.

# ── Background workers (Phase 1) ────────────────────────────────────────────
# Every worker is OFF unless enabled here. A worker that starts scanning every
# tenant as soon as the API boots is an operational surprise, and one process
# should own the scheduling decision rather than every replica.
#   OUTBOX            drains the transactional outbox (outbox.poller.ts)
#   MEMBERSHIP_EXPIRY transitions memberships past their end date (emits
#                     MembershipExpired.v1)
#   PAYMENT_RETRY     retries `pending` payments (idle until a payment gateway
#                     is configured; see src/finance/services/payment-gateway.port.ts)
# WORKERS_ENABLED is the master switch; WORKERS_<NAME>_ENABLED overrides it for
# a single worker. Ticks never overlap themselves, and a failing tick is logged
# without stopping the schedule.
WORKERS_ENABLED=false
# WORKERS_OUTBOX_ENABLED=false
# WORKERS_MEMBERSHIP_EXPIRY_ENABLED=false
# WORKERS_PAYMENT_RETRY_ENABLED=false
# Tick intervals in milliseconds (values below 1000 are ignored; the default is
# used instead). Defaults: outbox 10000, membership expiry 3600000, retry 900000.
# WORKERS_OUTBOX_INTERVAL_MS=10000
# WORKERS_MEMBERSHIP_EXPIRY_INTERVAL_MS=3600000
# WORKERS_PAYMENT_RETRY_INTERVAL_MS=900000

# ── Build provenance (build-time only) ──────────────────────────────────────
# `npm run build` always writes dist/build-info.json with a deterministic
# fingerprint of the build inputs; GET /v1/health reports it so a running image
# can be compared against a workspace.
# Docker image builds REQUIRE GIT_REVISION: the Dockerfile sets
# REQUIRE_GIT_REVISION=true and fails the build when it is missing or is not a
# 7-40 character hex Git object name, because an image that cannot name its
# source revision must not be deployable:
#   GIT_REVISION=$(git rev-parse HEAD) docker compose build api
# Local `npm run build` runs without REQUIRE_GIT_REVISION and keeps the
# documented development fallback (git rev-parse --short=12 HEAD, then
# "unknown"). APP_VERSION overrides the reported version label. Neither value
# ever affects the source fingerprint.
GIT_REVISION=
APP_VERSION=

